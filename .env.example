# Copy to .env and fill in. .env is gitignored; the two secrets below must
# never be committed.
#
# NOTE: values may contain spaces and are deliberately unquoted. Docker Compose
# parses this file itself and handles that correctly. A shell does not:
# `set -a; . ./.env` fails on a value like "No binaries check". Read individual
# values with grep/cut instead of sourcing the file.

# ---------------------------------------------------------------- required

# Shared secret for GitHub webhook signatures. Generate one with:
#   openssl rand -hex 32
# and paste the same value into the webhook's "Secret" field on GitHub.
# This is NOT a GitHub credential -- it is yours, and GitHub only ever uses it
# to sign deliveries so that real ones can be told from forgeries.
GITHUB_WEBHOOK_SECRET=

# Discord channel webhook, from Channel > Edit > Integrations > Webhooks.
# Anyone holding this URL can post to the channel.
DISCORD_WEBHOOK_URL=

# Public DNS name of the host, which Caddy serves and gets a certificate for.
# The webhook's Payload URL is then https://<this>/webhook. Only compose.yaml
# needs it; compose.dev.yaml has no Caddy and ignores it.
WEBHOOK_DOMAIN=

# ------------------------------------------------------------- forwarding

# 0 pauses posting without stopping the service: deliveries are still
# authenticated, summarised and logged, and are answered 200 so GitHub does not
# record failures. Stopping the container instead answers 502 to everything,
# and GitHub does not retry a failed delivery by itself.
DISCORD_ENABLED=1

# Checks are dropped by their owning GitHub App. "GitHub Actions" is the
# important one: every Actions job raises a workflow_job AND a check_run, so
# without this each job produces two messages. Dropping the Actions-owned
# checks leaves workflow_job -- which carries branch, runner and duration -- as
# the single source, while external apps that raise no workflow_job at all
# still come through.
IGNORE_CHECK_APPS=GitHub Actions

# Job and check names never forwarded, whichever event carries them. A single
# GitHub job raises BOTH a workflow_job and a check_run with the same name, so
# naming it once covers both. Matched case-insensitively against the whole name
# and against the segment after the last "/", so one "Spotless" entry also
# catches "acceptanceTests / Spotless".
#IGNORE_JOB_NAMES=Spotless,No binaries check

# Whole workflows never forwarded, matched on the workflow name or its file
# path (the path's basename is matched too, so "old_dco.yml" catches
# ".github/workflows/old_dco.yml").
#IGNORE_WORKFLOWS=Old DCO,old_dco.yml

# Allowlist. When set, it turns the policy round: the ONLY thing forwarded is
# the completed workflow_run of a workflow listed here, by name or file path
# (basename is enough). Every other event -- jobs, checks, pushes, PRs -- is
# declined, with a reason naming this setting. The ignore lists above still
# apply to what is left, so a green run needs FORWARD_SUCCESS=1 to be seen.
# Prefer the file name: a workflow's display name can be changed by anyone who
# edits the file, and the file name tends to stay put.
#ONLY_WORKFLOWS=nightly.yml

# ------------------------------------------------------------------ queue

# Every forwardable delivery is written to queue/waiting, then posted by a
# worker and moved to queue/delivered -- or, if it is still failing after the
# retry window, to queue/failed. Each item holds BOTH legs: the GitHub headers
# and body as received, and the exact Discord payload and response.
#
# Nothing here needs setting; the defaults are shown.

# How long to keep retrying a failing post before filing it under queue/failed.
#RETRY_WINDOW_HOURS=24

# queue/delivered is a short-lived record of what went out.
#DELIVERED_RETENTION_HOURS=6

# queue/waiting and queue/failed are the ones worth keeping.
#QUEUE_RETENTION_DAYS=7

# queue/skipped records everything policy declined to forward, with the reason
# and the inbound body. It is what makes "why did nothing appear in Discord?"
# answerable by looking, rather than by turning a debug mode on after the fact.
# 0 stops recording them entirely; the audit log still counts them with their
# reason, it just will not keep the payloads.
#LOG_SKIPPED=1

# It is the bulk of the traffic on a busy repository and nothing is pending on
# it, so it ages out fast.
#SKIPPED_RETENTION_MINUTES=60

# --------------------------------------------- defaults, shown for reference
# Uncomment only to change them.

# Outcomes that need no attention. cancelled is included because a fail-fast
# matrix cancels every sibling when one job fails, so cancelled is usually
# collateral rather than a result of its own; a skipped job never ran. Setting
# this replaces the whole list.
#IGNORE_CONCLUSIONS=success,cancelled,skipped

# 1 forwards green results too, overriding IGNORE_CONCLUSIONS entirely.
#FORWARD_SUCCESS=0

# 1 forwards check_suite. Off because a check_suite is only a container for one
# app's check_runs on a commit and reports no outcome those runs do not.
#FORWARD_CHECK_SUITE=0

# Audit log: JSON lines, one file per UTC day per direction, kept 30 days.
#LOG_RETENTION_DAYS=30

# The compose files fix LISTEN_ADDR, LOG_DIR and QUEUE_DIR inside the
# container. They matter only when running the binary directly; see "Running
# without Docker" in README.md.
#LISTEN_ADDR=:8080
#LOG_DIR=/var/log/reflector
#QUEUE_DIR=/var/queue
